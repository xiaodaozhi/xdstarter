// src/experimental/start_bridge/poc_version.rc

#include <winver.h>

1 VERSIONINFO
FILEVERSION 1,0,0,52
PRODUCTVERSION 1,0,0,52
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "XDStarter controlled input bridge experiment\0"
            VALUE "FileVersion", "1.0.0.52\0"
            VALUE "ProductName", "XDStarter Bridge PoC 52\0"
            VALUE "ProductVersion", "1.0.0.52\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
