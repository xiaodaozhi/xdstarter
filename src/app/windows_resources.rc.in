// The ICO is generated from the same original identity as the QML resources.
IDI_XDSTARTER ICON "@XDSTARTER_ICON_FILE@"

#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XDSTARTER_BUILD_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XDSTARTER_BUILD_NUMBER@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "XDStarter\0"
   VALUE "FileVersion", "@PROJECT_VERSION@.@XDSTARTER_BUILD_NUMBER@\0"
   VALUE "InternalName", "xdstarter\0"
   VALUE "OriginalFilename", "xdstarter.exe\0"
   VALUE "ProductName", "XDStarter\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "Comments", "commit @XDSTARTER_REVISION@; dirty=@XDSTARTER_DIRTY@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
